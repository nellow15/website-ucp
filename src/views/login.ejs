    </nav>

    <!-- Main Content -->
    <div class="main-container">
        <div class="login-wrapper">
            <div class="login-card animate-fade-in">
                <div class="card-header">
                    <h1 class="card-title">Secure Login</h1>
                    <p class="card-subtitle">Access your SA:MP UCP account with enhanced security</p>
                </div>

                <div class="form-content">
                    <!-- Alerts -->
                    <% if (error_msg && error_msg.length > 0) { %>
                        <div class="alert alert-error">
                            <i class="fas fa-exclamation-circle alert-icon"></i>
                            <%= error_msg %>
                        </div>
                    <% } %>

                    <% if (success_msg && success_msg.length > 0) { %>
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle alert-icon"></i>
                            <%= success_msg %>
                        </div>
                    <% } %>

                    <form method="POST" action="/login" id="loginForm">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-user"></i>
                                Username
                            </label>
                            <div class="input-container">
                                <input type="text" name="username" id="username" class="form-input" required autofocus 
                                       placeholder="Enter your username"
                                       oninput="checkUsername()">
                                <i class="fas fa-user form-icon"></i>
                            </div>
                            <div id="usernameStatus" class="validation-status" style="display: none;"></div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-lock"></i>
                                Password
                            </label>
                            <div class="input-container">
                                <input type="password" name="password" id="password" class="form-input" required 
                                       placeholder="Enter your password">
                                <i class="fas fa-lock form-icon"></i>
                                <button type="button" class="password-toggle" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="button-container">
                            <button type="submit" class="login-btn" id="loginButton">
                                <i class="fas fa-sign-in-alt"></i>
                                Login to Account
                            </button>
                            
                            <!-- Tombol Create New Account dengan animasi biasa -->
                            <a href="/register" class="register-btn">
                                <i class="fas fa-user-plus"></i>
                                Create New Account
                            </a>
                        </div>

                        <div class="additional-links">
                            <div class="back-link">
                                <a href="/">
                                    <i class="fas fa-arrow-left"></i>
                                    Back to Home
                                </a>
                            </div>
                            <div class="register-link">
                                <a href="/register">
                                    Sign up now
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <!-- Brand Column -->
                <div class="footer-brand">
                    <a href="/" class="footer-logo">
                        CENTRA ROLEPLAY
                    </a>
                    <p class="footer-description">
                        Professional SA:MP User Control Panel providing secure account management 
                        and enhanced gaming experience for San Andreas Multiplayer community.
                    </p>
                    <div class="footer-social">
                        <a href="https://discord.gg/uUgqeDDf3B" class="social-link" aria-label="Discord">
                            <i class="fab fa-discord"></i>
                        </a>
                        <a href="https://github.com/nellow15" class="social-link" aria-label="GitHub">
                            <i class="fab fa-github"></i>
                        </a>
                    </div>
                </div>

                <!-- Links Columns -->
                <div class="footer-links-container">
                    <div class="footer-links-column">
                        <h4 class="footer-column-title">Navigation</h4>
                        <a href="/" class="footer-link">
                            <i class="fas fa-home"></i>
                            Home
                        </a>
                        <a href="/login" class="footer-link">
                            <i class="fas fa-sign-in-alt"></i>
                            Login
                        </a>
                        <a href="/register" class="footer-link">
                            <i class="fas fa-user-plus"></i>
                            Register
                        </a>
                        <a href="/about" class="footer-link">
                            <i class="fas fa-info-circle"></i>
                            About Us
                        </a>
                    </div>

                    <div class="footer-links-column">
                        <h4 class="footer-column-title">Resources</h4>
                        <a href="/guides" class="footer-link">
                            <i class="fas fa-book"></i>
                            Guides
                        </a>
                        <a href="/faq" class="footer-link">
                            <i class="fas fa-question-circle"></i>
                            FAQ
                        </a>
                        <a href="/support" class="footer-link">
                            <i class="fas fa-headset"></i>
                            Support
                        </a>
                        <a href="/status" class="footer-link">
                            <i class="fas fa-server"></i>
                            Server Status
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bottom Bar -->
            <div class="footer-bottom">
                <div class="footer-copyright">
                    <p>
                        <i class="fas fa-copyright"></i>
                        2025 CENTRA ROLEPLAY. All rights reserved.
                    </p>
                </div>
                <div class="footer-legal">
                    <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
                    <a href="/terms" class="footer-legal-link">Terms of Service</a>
                    <a href="/cookies" class="footer-legal-link">Cookie Policy</a>
                    <a href="/legal" class="footer-legal-link">Legal Notice</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // Variables untuk debounce
        let checkUsernameTimeout = null;
        let lastCheckedUsername = '';

        // Password visibility toggle
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.getElementById('password');
            const icon = this.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.className = 'fas fa-eye-slash';
                this.setAttribute('aria-label', 'Hide password');
            } else {
                passwordInput.type = 'password';
                icon.className = 'fas fa-eye';
                this.setAttribute('aria-label', 'Show password');
            }
        });

        // Fungsi untuk memeriksa username menggunakan API
        async function checkUsername() {
            const usernameInput = document.getElementById('username');
            const username = usernameInput.value.trim();
            const statusDiv = document.getElementById('usernameStatus');
            
            // Reset status
            usernameInput.classList.remove('checking', 'available', 'not-found');
            statusDiv.style.display = 'none';
            
            // Minimal 3 karakter untuk pengecekan
            if (username.length < 3) {
                return;
            }
            
            // Jika username sama dengan yang terakhir dicek, skip
            if (username === lastCheckedUsername) {
                return;
            }
            
            // Clear previous timeout
            if (checkUsernameTimeout) {
                clearTimeout(checkUsernameTimeout);
            }
            
            // Debounce: tunggu 500ms setelah user berhenti mengetik
            checkUsernameTimeout = setTimeout(async () => {
                try {
                    // Tampilkan status checking
                    statusDiv.style.display = 'flex';
                    statusDiv.className = 'validation-status status-checking';
                    statusDiv.innerHTML = `
                        <div class="spinner" style="border-top-color: #666;"></div>
                        <span>Checking username availability...</span>
                    `;
                    usernameInput.classList.add('checking');
                    
                    lastCheckedUsername = username;
                    
                    // Panggil API yang sudah ada: GET /api/check-username/:username
                    const response = await fetch(`/api/check-username/${encodeURIComponent(username)}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });
                    
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    
                    const data = await response.json();
                    
                    // Update status berdasarkan response
                    // API mengembalikan: { available: true/false }
                    // available: true = username TIDAK ditemukan (tidak terdaftar)
                    // available: false = username ditemukan (terdaftar)
                    
                    if (data.available === false) {
                        // Username DITEMUKAN di database (terdaftar)
                        statusDiv.className = 'validation-status status-available';
                        statusDiv.innerHTML = `
                            <i class="fas fa-check-circle status-icon"></i>
                            <span>✓ Username is available for login</span>
                        `;
                        usernameInput.classList.remove('checking');
                        usernameInput.classList.add('available');
                    } else if (data.available === true) {
                        // Username TIDAK DITEMUKAN (tidak terdaftar)
                        statusDiv.className = 'validation-status status-not-found';
                        statusDiv.innerHTML = `
                            <i class="fas fa-exclamation-circle status-icon"></i>
                            <span>✗ Username not found in our system</span>
                        `;
                        usernameInput.classList.remove('checking');
                        usernameInput.classList.add('not-found');
                    }
                    
                } catch (error) {
                    console.error('Error checking username:', error);
                    // Jika error, sembunyikan status
                    statusDiv.style.display = 'none';
                    usernameInput.classList.remove('checking');
                }
            }, 500); // Delay 500ms
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            const usernameField = document.getElementById('username');
            if (usernameField) {
                usernameField.focus();
            }
            
            // Handle form submission
            const loginForm = document.getElementById('loginForm');
            const loginButton = document.getElementById('loginButton');
            
            loginForm.addEventListener('submit', function(e) {
                const username = document.getElementById('username').value.trim();
                const password = document.getElementById('password').value.trim();
                
                if (!username || !password) {
                    e.preventDefault();
                    showToast('Please fill in all required fields', 'error');
                    return;
                }
                
                // Validasi username minimal 3 karakter
                if (username.length < 3) {
                    e.preventDefault();
                    showToast('Username must be at least 3 characters', 'error');
                    return;
                }
                
                // Cek apakah username sedang dicek
                const isChecking = document.getElementById('username').classList.contains('checking');
                if (isChecking) {
                    e.preventDefault();
                    showToast('Please wait while we verify your username', 'info');
                    return;
                }
                
                // Cek apakah username tidak ditemukan
                const isNotFound = document.getElementById('username').classList.contains('not-found');
                if (isNotFound) {
                    e.preventDefault();
                    showToast('Username not found. Please check your username or register.', 'error');
                    return;
                }
                
                // Show loading state
                const originalText = loginButton.innerHTML;
                loginButton.innerHTML = `
                    <div class="spinner"></div>
                    <span>Authenticating...</span>
                `;
                loginButton.disabled = true;
                
                // Reset button jika form submission gagal
                setTimeout(() => {
                    loginButton.innerHTML = originalText;
                    loginButton.disabled = false;
                }, 3000);
            });
        });

        // Auto-hide alerts
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);

        // Fungsi untuk menampilkan toast notification
        function showToast(message, type = 'info') {
            // Hapus toast sebelumnya jika ada
            const existingToast = document.querySelector('.toast');
            if (existingToast) {
                existingToast.remove();
            }
            
            // Buat toast baru
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            // Set icon berdasarkan type
            let icon = 'fas fa-info-circle';
            if (type === 'error') icon = 'fas fa-exclamation-circle';
            if (type === 'success') icon = 'fas fa-check-circle';
            
            toast.innerHTML = `
                <i class="${icon}"></i>
                <span>${message}</span>
            `;
            
            document.body.appendChild(toast);
            
            // Auto remove setelah 4 detik
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.5s ease';
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        }

        // Smooth scroll untuk anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>