                    <div class="footer-copyright">
                        <p>
                            <i class="fas fa-copyright"></i>
                            2025 CENTRA ROLEPLAY. All rights reserved.
                        </p>
                    </div>
                    <div class="footer-legal">
                        <a href="/privacy" class="footer-legal-link">Privacy Policy</a>
                        <a href="/terms" class="footer-legal-link">Terms of Service</a>
                        <a href="/cookies" class="footer-legal-link">Cookie Policy</a>
                        <a href="/legal" class="footer-legal-link">Legal Notice</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script>
        // Cookie Consent Management
        document.addEventListener('DOMContentLoaded', function() {
            const cookieConsent = document.getElementById('cookieConsent');
            const acceptBtn = document.getElementById('acceptCookies');
            const rejectBtn = document.getElementById('rejectCookies');
            
            // Check if cookie consent has been given
            const cookiesAccepted = localStorage.getItem('cookiesAccepted');
            
            if (!cookiesAccepted) {
                // Show cookie consent after 1 second
                setTimeout(() => {
                    cookieConsent.classList.add('show');
                }, 1000);
            }
            
            // Accept All Cookies
            acceptBtn.addEventListener('click', function() {
                localStorage.setItem('cookiesAccepted', 'all');
                localStorage.setItem('cookiesConsentDate', new Date().toISOString());
                cookieConsent.classList.remove('show');
                
                // Set essential cookies
                setEssentialCookies();
                // Set analytics cookies
                setAnalyticsCookies();
                
                showToast('All cookies accepted. Thank you!', 'success');
            });
            
            // Reject All (Essential Only)
            rejectBtn.addEventListener('click', function() {
                localStorage.setItem('cookiesAccepted', 'essential');
                localStorage.setItem('cookiesConsentDate', new Date().toISOString());
                cookieConsent.classList.remove('show');
                
                // Set only essential cookies
                setEssentialCookies();
                
                showToast('Essential cookies set. Thank you!', 'info');
            });
            
            // Set essential cookies (always needed)
            function setEssentialCookies() {
                const expires = new Date();
                expires.setFullYear(expires.getFullYear() + 1);
                
                // Session cookie
                document.cookie = `session_consent=true; expires=${expires.toUTCString()}; path=/; Secure; SameSite=Strict`;
                
                // CSRF token cookie (if needed)
                document.cookie = `csrf_consent=true; expires=${expires.toUTCString()}; path=/; Secure; SameSite=Strict`;
            }
            
            // Set analytics/marketing cookies
            function setAnalyticsCookies() {
                const expires = new Date();
                expires.setFullYear(expires.getFullYear() + 1);
                
                // Analytics cookie
                document.cookie = `analytics_consent=true; expires=${expires.toUTCString()}; path=/; Secure; SameSite=Strict`;
                
                // Marketing cookie
                document.cookie = `marketing_consent=true; expires=${expires.toUTCString()}; path=/; Secure; SameSite=Strict`;
                
                // Here you would typically initialize Google Analytics or other tracking
                console.log('Analytics and marketing cookies set');
            }
            
            // Check existing cookies on page load
            checkCookies();
        });
        
        function checkCookies() {
            const cookies = document.cookie.split(';');
            const cookieData = {};
            
            cookies.forEach(cookie => {
                const [name, value] = cookie.trim().split('=');
                cookieData[name] = value;
            });
            
            // You can use this data for various purposes
            console.log('Current cookies:', cookieData);
        }
        
        // Copy Verify Code to clipboard
        function copyVerifyCode() {
            <% if (user && user.verifyCode) { %>
            const verifyCode = '<%= user.verifyCode %>';
            navigator.clipboard.writeText(verifyCode).then(() => {
                showToast(`Copied to clipboard: ${verifyCode}`, 'success');
            }).catch(err => {
                console.error('Failed to copy: ', err);
                showToast('Failed to copy verify code', 'error');
            });
            <% } else { %>
            showToast('No verify code available', 'info');
            <% } %>
        }

        // Auto-hide alerts
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);

        // Video fallback for unsupported browsers
        document.addEventListener('DOMContentLoaded', function() {
            const video = document.querySelector('.video-background video');
            if (video && video.paused) {
                video.play().catch(e => {
                    console.log('Video autoplay failed:', e);
                    // Fallback to poster image
                    const poster = video.getAttribute('poster');
                    if (poster) {
                        document.querySelector('.video-background').style.backgroundImage = `url(${poster})`;
                        document.querySelector('.video-background').style.backgroundSize = 'cover';
                        document.querySelector('.video-background').style.backgroundPosition = 'center';
                    }
                });
            }
        });

        // Toast notification function
        function showToast(message, type = 'info') {
            // Remove existing toast
            const existingToast = document.querySelector('.toast-notification');
            if (existingToast) {
                existingToast.remove();
            }
            
            // Create toast
            const toast = document.createElement('div');
            toast.className = `toast-notification toast-${type}`;
            toast.style.cssText = `
                position: fixed;
                top: 30px;
                right: 30px;
                padding: 1rem 1.5rem;
                border-radius: 12px;
                color: white;
                font-weight: 500;
                z-index: 9999;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
                animation: slideIn 0.3s ease-out;
                min-width: 300px;
                max-width: 400px;
            `;
            
            // Set background based on type
            if (type === 'success') toast.style.background = '#059669';
            else if (type === 'error') toast.style.background = '#dc2626';
            else toast.style.background = '#000000';
            
            // Set icon
            let icon = 'fas fa-info-circle';
            if (type === 'error') icon = 'fas fa-exclamation-circle';
            if (type === 'success') icon = 'fas fa-check-circle';
            
            toast.innerHTML = `
                <i class="${icon}"></i>
                <span>${message}</span>
            `;
            
            document.body.appendChild(toast);
            
            // Auto remove after 3 seconds
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.5s ease';
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }
    </script>
</body>
</html>
