                    <% } %>
                </div>
            </div>
        </main>

        <!-- FOOTER - IMPROVED DESIGN -->
        <footer class="footer">
            <div class="footer-container">
                <div class="footer-grid">
                    <!-- Brand Column -->
                    <div class="footer-brand">
                        <a href="/" class="footer-logo">
