                                </div>
                                <div style="text-align: center;">
                                    <div style="width: 60px; height: 60px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-weight: bold; font-size: 1.2rem;">
                                        <i class="fas fa-gamepad"></i>
                                    </div>
                                    <h4 style="color: #000; margin-bottom: 0.5rem; font-weight: 600;">Play</h4>
                                    <p style="color: #666; font-size: 0.9rem;">Use verification code to access game</p>
                                </div>
                            </div>
                        </div>

                    <% } else { %>
                        <!-- Welcome Section for Logged-in Users -->
                        <div class="text-center mt-4">
                            <div style="width: 100px; height: 100px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem; font-size: 2.5rem;">
                                <i class="fas fa-user"></i>
                            </div>
                            
                            <h2 class="mb-2" style="font-size: 2rem; color: #333; font-weight: 600;">
                                Welcome Back, <%= user.username %>!
                            </h2>
                            
                            <p class="mb-4" style="color: #666; max-width: 500px; margin: 0 auto 2rem;">
                                Your account is ready to go. Access all your SA:MP UCP features from the dashboard.
                            </p>
                            
                            <div class="btn-group">
                                <a href="/dashboard" class="btn" style="padding: 1rem 2.5rem;">
                                    <i class="fas fa-tachometer-alt btn-icon"></i>
                                    Go to Dashboard
                                </a>
                                <% if (user.verifyCode) { %>
                                <button class="btn btn-outline" onclick="copyVerifyCode()" style="padding: 1rem 2.5rem;">
                                    <i class="fas fa-copy btn-icon"></i>
                                    Copy Game Code
                                </button>
                                <% } %>
                            </div>
                            
                            <% if (user.verifyCode) { %>
                            <div class="mt-4 p-3" style="background: rgba(0, 0, 0, 0.05); border-radius: 8px; border-left: 4px solid #000;">
                                <p style="margin: 0; color: #333;">
                                    <i class="fas fa-gamepad" style="color: #000;"></i>
                                    <strong>Game Verification Code:</strong> 
                                    <span id="verifyCode" style="font-family: monospace; font-weight: bold; color: #000;">
                                        <%= user.verifyCode %>
                                    </span>
                                </p>
                            </div>
                            <% } %>
                        </div>

                        <!-- Quick Stats -->
                        <div class="dashboard-stats">
                            <div class="stat-card">
                                <div class="stat-value">
                                    <i class="fas fa-user-check"></i>
                                </div>
                                <div class="stat-label">Account Verified</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-value">
                                    <i class="fas fa-envelope"></i>
                                </div>
                                <div class="stat-label"><%= user.email %></div>
                            </div>
                            <% if (user.phone) { %>
                            <div class="stat-card">
                                <div class="stat-value">
                                    <i class="fas fa-phone"></i>
                                </div>
                                <div class="stat-label"><%= user.phone %></div>
                            </div>
