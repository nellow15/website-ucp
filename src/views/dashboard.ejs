    <script>
        // Update server time
        function updateServerTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour12: false,
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            const el = document.getElementById('server-time');
            if (el) el.textContent = timeString;
        }
        
        setInterval(updateServerTime, 1000);
        updateServerTime();

        // Copy Verify Code to clipboard
        function copyVerifyCode() {
            <% if (user.verifyCode) { %>
            const verifyCode = '<%= user.verifyCode %>';
            navigator.clipboard.writeText(verifyCode).then(() => {
                showToast('Verification code copied to clipboard!');
            }).catch(err => {
                console.error('Failed to copy:', err);
                showToast('Failed to copy code', 'error');
            });
            <% } else { %>
            showToast('No verification code available', 'error');
            <% } %>
        }

        // ── Email OTP ──────────────────────────────────────────────────────────
        let otpSending = false;

        async function sendEmailOTP(btn) {
            if (otpSending) return;
            otpSending = true;
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…'; }

            try {
                const res  = await fetch('/verify/email/send', { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    document.getElementById('otp-panel').classList.add('active');
                    showToast('OTP sent! Check your email inbox.');
                } else {
                    showToast(data.error || 'Failed to send OTP', 'error');
                }
            } catch (e) {
                showToast('Network error. Try again.', 'error');
            } finally {
                otpSending = false;
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send OTP'; }
            }
        }

        async function confirmEmailOTP() {
            const otp = document.getElementById('otp-input').value.trim();
            if (otp.length !== 6) { showToast('Please enter the 6-digit code', 'error'); return; }

            try {
                const res  = await fetch('/verify/email/confirm', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ otp })
                });
                const data = await res.json();

                if (data.success) {
                    showToast('Email verified successfully!');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast(data.error || 'Invalid OTP', 'error');
                }
            } catch (e) {
                showToast('Network error. Try again.', 'error');
            }
        }

        // ── Discord callback toast ─────────────────────────────────────────────
        (function () {
            const params = new URLSearchParams(window.location.search);
            const discord = params.get('discord');
            if (discord === 'success') showToast('Discord account connected!');
            if (discord === 'error')   showToast('Discord connection failed. Try again.', 'error');
            if (discord === 'taken')   showToast('This Discord account is already linked to another user.', 'error');
            if (discord) {
                // Remove query param from URL without reload
                const url = new URL(window.location.href);
                url.searchParams.delete('discord');
                history.replaceState({}, '', url.toString());
            }
        })();

        // Toast notification
        function showToast(message, type = 'success') {
            const existingToast = document.querySelector('.toast');
            if (existingToast) existingToast.remove();
            
            const toast = document.createElement('div');
            toast.className = 'toast';
            
            let icon = 'fas fa-check-circle';
            if (type === 'error') icon = 'fas fa-exclamation-circle';
            if (type === 'info')  icon = 'fas fa-info-circle';
            
            toast.innerHTML = `<i class="${icon}"></i><span>${message}</span>`;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Set registration date
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const regDate = now.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
            document.getElementById('reg-date').textContent = regDate;
        });
    </script>
</body>
</html>
