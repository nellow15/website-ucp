    <script>
        // ── Accordion / Toggle Answer ───────────────────────────────────
        function toggleAnswer(element) {
            const answerDiv = element.nextElementSibling;
            const isActive = element.classList.contains('active');
            
            // Close all other answers
            document.querySelectorAll('.faq-question').forEach(q => {
                if (q !== element && q.classList.contains('active')) {
                    q.classList.remove('active');
                    const otherAnswer = q.nextElementSibling;
                    otherAnswer.style.maxHeight = null;
                    otherAnswer.classList.remove('open');
                }
            });
            
            // Toggle current answer
            if (!isActive) {
                element.classList.add('active');
                answerDiv.style.maxHeight = answerDiv.scrollHeight + 'px';
                answerDiv.classList.add('open');
            } else {
                element.classList.remove('active');
                answerDiv.style.maxHeight = null;
                answerDiv.classList.remove('open');
            }
        }

        // ── Category Filter ────────────────────────────────────────────
        let currentCategory = 'all';
        
        function filterCategory(category) {
            currentCategory = category;
            
            // Update active button styling
            document.querySelectorAll('.category-tab').forEach(btn => {
                const btnCategory = btn.getAttribute('data-category');
                if (btnCategory === category) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            
            // Filter cards
            const cards = document.querySelectorAll('.faq-card');
            let visibleCount = 0;
            
            cards.forEach(card => {
                const cardCategory = card.getAttribute('data-category');
                if (category === 'all' || cardCategory === category) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Hide empty state if there are visible cards
            const emptyState = document.getElementById('emptyState');
            if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        // ── Search Functionality ───────────────────────────────────────
        function searchFAQ() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.faq-card');
            const emptyState = document.getElementById('emptyState');
            let visibleCount = 0;
            
            cards.forEach(card => {
                const question = card.getAttribute('data-question') || '';
                const answer = card.getAttribute('data-answer') || '';
                const category = card.getAttribute('data-category');
                
                // Check if matches category filter AND search term
                const matchesCategory = (currentCategory === 'all' || category === currentCategory);
                const matchesSearch = searchTerm === '' || question.includes(searchTerm) || answer.includes(searchTerm);
                
                if (matchesCategory && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            // Show/hide empty state
            if (emptyState) {
                if (visibleCount === 0 && searchTerm !== '') {
                    emptyState.style.display = 'block';
                } else {
                    emptyState.style.display = 'none';
                }
            }
        }

        // ── Dropdown ────────────────────────────────────────────────────
        function toggleDropdown() {
            const btn = document.getElementById('nav-user-btn');
            const dd = document.getElementById('nav-dropdown');
            if (btn && dd) {
                btn.classList.toggle('open');
                dd.classList.toggle('open');
            }
        }
        
        document.addEventListener('click', function(e) {
            const wrap = document.querySelector('.nav-user-wrap');
            if (wrap && !wrap.contains(e.target)) {
                const btn = document.getElementById('nav-user-btn');
                const dd = document.getElementById('nav-dropdown');
                if (btn && dd) {
                    btn.classList.remove('open');
                    dd.classList.remove('open');
                }
            }
        });

        // Optional: Auto-open first FAQ on page load for better UX
        document.addEventListener('DOMContentLoaded', function() {
            const firstFaq = document.querySelector('.faq-card .faq-question');
            if (firstFaq) {
                // Uncomment to auto-open first FAQ
                // setTimeout(() => toggleAnswer(firstFaq), 300);
            }
        });
    </script>
